{
  "id": "tiohentai",
  "name": "TioHentai",
  "version": "1.1.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "description": "Hentai ES de tiohentai.com. Usa kino-resolver (Voe) + YourUpload local + captura browser.",
  "author": "Hotaru Yume",
  "creator": "hotaruyume",
  "homepage": "https://tiohentai.com",
  "hosts": [
    "tiohentai.com",
    "*.tiohentai.com",
    "yourupload.com",
    "*.yourupload.com",
    "vidcache.net",
    "*.vidcache.net",
    "voe.sx",
    "*.voe.sx"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "browser": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "categories": [
    "anime",
    "series"
  ],
  "color": "#C81428",
  "icon": "icon.png",
  "theme": {
    "accent": "#C81428",
    "onAccent": "#FFFFFF",
    "background": "#0D0D0D",
    "surface": "#1A1A1A",
    "highlight": "#E53935"
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  }
}
